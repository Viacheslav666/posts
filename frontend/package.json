{
  "name": "posts-frontend",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm --filter @posts/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "gen:api": "pnpm --filter @posts/api-client gen:api",
    "storybook": "pnpm --filter @posts/ui storybook",
    "build-storybook": "pnpm --filter @posts/ui build-storybook"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
