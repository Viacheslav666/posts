# Local development defaults (docker-compose + apps)
POSTGRES_URL=jdbc:postgresql://localhost:5432/posts
POSTGRES_USER=posts
POSTGRES_PASSWORD=posts

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=posts
RABBITMQ_PASSWORD=posts

# Local S3-compatible endpoint (adobe/s3mock in DEV-1; MinIO planned for staging)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=posts
S3_SECRET_KEY=postsposts
S3_BUCKET=posts-media

CLICKHOUSE_URL=http://localhost:8123
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# FE-2: enable MSW auth mocks in the Next.js web app (also on by default in next dev)
NEXT_PUBLIC_API_MOCKING=true

# Social emulator (QA-3): make emulator / make up-emulator
# In compose profile `full` (DEV-4) apps use http://social-emulator:8090
SOCIAL_EMULATOR_URL=http://localhost:8090
POSTS_SOCIAL_BASE_URL=http://localhost:8090

# Publisher network (DEV-4 / BE-4): set per Deployment / compose service
# POSTS_PUBLISHER_NETWORK=vk|tg|ok|max|rutube
